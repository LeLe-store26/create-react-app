    <Card key={product.id} className="border rounded-lg shadow-md p-4">
      <img src={product.image} alt={product.name[language]} className="w-full h-40 object-cover" />
      <CardContent>
        <h3 className="text-lg font-semibold">{product.name[language]}</h3>
        <p className="text-gray-600 text-sm">{product.description[language]}</p>
        <div className="flex justify-between items-center mt-3">
          <p className="text-primary font-bold">{product.price.toFixed(2)} دينار</p>
          <Badge variant="secondary">{product.stock} متوفر</Badge>
        </div>
        <Button 
          className="mt-3 w-full" 
          onClick={() => addToCart(product)}
          disabled={product.stock <= 0}
        >
          {product.stock <= 0 ? "نفذت الكمية" : "إضافة للسلة"}
        </Button>
      </CardContent>
