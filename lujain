                import { useState } from "react";
import ProductCard from "./ProductCard";
import { Select } from "@/components/ui/select";

const translations = {
  ar: { storeName: "🛍️ متجر LeLe", availableProducts: "🛒 المنتجات المتاحة", language: "اللغة" },
  en: { storeName: "🛍️ LeLe Store", availableProducts: "🛒 Available Products", language: "Language" },
};

const products = [
  { 
    id: 1, name: { ar: "مسكارا Shedoes", en: "Shedoes Mascara" }, price: 1.4, 
    image: "https://img.kwcdn.com/product/Fancyalgo/17e7dfba.jpg", 
    description: { ar: "ماسكارا مكثفة", en: "Volumizing mascara" }, stock: 24 
  },
  { 
    id: 2, name: { ar: "مرطب الفراولة", en: "Strawberry Lip Balm" }, price: 0.7, 
    image: "https://img.kwcdn.com/product/fancy/c93ec2a7.jpg", 
    description: { ar: "مرطب وملون للشفاه", en: "Lip moisturizer & tint" }, stock: 20 
  },
  { 
    id: 3, name: { ar: "مرطب شفاف", en: "Clear Lip Balm" }, price: 0.35, 
    image: "https://img.kwcdn.com/product/fancy/27976ce7.jpg", 
    description: { ar: "مرطب شفاف متعدد الاستخدامات", en: "Multi-purpose clear balm" }, stock: 24 
  }
];

export default function Store() {
  const [cart, setCart] = useState([]);
  const [language, setLanguage] = useState("ar");
  const t = translations[language];

  const addToCart = (product) => setCart([...cart, { ...product, quantity: 1 }]);

  return (
    <div className="p-4 max-w-4xl mx-auto min-h-screen">
      <header className="mb-6 border-b pb-4 flex justify-between items-center">
        <h1 className="text-2xl font-bold">{t.storeName}</h1>
        <Select value={language} onChange={(e) => setLanguage(e.target.value)}>
          <option value="ar">العربية</option>
          <option value="en">English</option>
        </Select>
      </header>
      <div className="mb-8">
        <h2 className="text-xl font-semibold">{t.availableProducts}</h2>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {products.map((product) => (
            <ProductCard key={product.id} product={product} language={language} addToCart={addToCart} />
          ))}
        </div>
      </div>
    </div>
  );
}
